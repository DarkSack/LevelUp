# Copia este archivo a .env.local y rellena con tus credenciales de InsForge
# (panel del proyecto → Settings → API keys).
INSFORGE_BASE_URL=https://<tu-proyecto>.insforge.app
INSFORGE_ANON_KEY=anon_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INSFORGE_API_KEY=ik_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
