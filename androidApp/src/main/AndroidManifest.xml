<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Cuenta opcional, sincronización y amigos (Supabase); compra de Plus. Sin cuenta la app no usa la red. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Recordatorios. Se pide solo cuando la persona los activa (Android 13 o más). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WorkManager lo declara para trabajos en primer plano; LevelUp no los usa. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <!-- Health Connect: solo lectura de pasos y ejercicio de hoy, y solo si se activa en Laboratorio. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />

    <!-- Android 13 o menos: saber si Health Connect está instalado. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- Copia automática de Android activada: así el progreso pasa a un teléfono nuevo sin cuentas.
         La sesión de la cuenta no se copia (ver res/xml). -->
    <application
        android:name=".LevelUpApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:localeConfig="@xml/locales_config"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LevelUp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Enlaces de atajos, widget y automatizaciones (levelup://hoy, enfoque, buscar, metas, logros, privacidad,
                 reto/<id>). Solo abren pantallas: no devuelven datos ni completan nada. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="levelup" />
            </intent-filter>
            <!-- Android 13 o menos: el botón «política de privacidad» de los permisos de Health Connect. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- Android 14 o más: lo mismo para los permisos de salud. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Mensajes del reloj (completar un reto, pedir los datos de hoy). Solo los manda la app LevelUp del reloj. -->
        <service android:name=".WearListenerService" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:host="*" android:pathPrefix="/levelup" android:scheme="wear" />
            </intent-filter>
        </service>

        <receiver android:name=".TodayWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
