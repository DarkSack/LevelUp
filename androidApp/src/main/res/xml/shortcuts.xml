<?xml version="1.0" encoding="utf-8"?>
<!-- Atajos del lanzador (mantén pulsado el icono). Solo abren pantallas. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="hoy"
        android:shortcutLongLabel="@string/shortcut_today_long"
        android:shortcutShortLabel="@string/shortcut_today">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="levelup://hoy"
            android:targetClass="app.levelup.MainActivity"
            android:targetPackage="sack.levelup" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="enfoque"
        android:shortcutLongLabel="@string/shortcut_focus_long"
        android:shortcutShortLabel="@string/shortcut_focus">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="levelup://enfoque"
            android:targetClass="app.levelup.MainActivity"
            android:targetPackage="sack.levelup" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="buscar"
        android:shortcutLongLabel="@string/shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="levelup://buscar"
            android:targetClass="app.levelup.MainActivity"
            android:targetPackage="sack.levelup" />
    </shortcut>
</shortcuts>
