<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: splash de la marca (fondo verde azulado y las barras del logo) en vez del icono sobre fondo claro. -->
    <style name="Theme.LevelUp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window</item>
        <item name="android:windowSplashScreenBackground">@color/brand</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
